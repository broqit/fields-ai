{
    "name": "broqit/fields-ai",
    "description": "fields-ai is a powerful FilamentPHP plugin that integrates ChatGPT AI-powered features directly into your Filament forms.",
    "keywords": [
        "broqit",
        "fields-ai",
        "laravel",
        "laravel-package",
        "filament-plugin",
        "filamentphp",
        "chat-gpt",
        "ai-content-generation"
    ],
    "homepage": "https://github.com/broqit/fields-ai",
    "support": {
        "issues": "https://github.com/broqit/fields-ai/issues",
        "source": "https://github.com/broqit/fields-ai"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Roman Borkunov",
            "email": "ya.qnut@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.3",
        "spatie/laravel-package-tools": "^1.92",
        "openai-php/laravel": "^0.8",
        "masterminds/html5": "^2.10"
    },
    "require-dev": {
        "nunomaduro/collision": "^7.12",
        "pestphp/pest": "^2.36",
        "pestphp/pest-plugin-arch": "^2.7",
        "pestphp/pest-plugin-laravel": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Broqit\\FieldsAi\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Broqit\\FieldsAi\\FieldsAiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
